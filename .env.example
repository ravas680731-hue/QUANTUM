# Copy to .env (or set in your MCP client config) and adjust as needed.
# All variables are optional; sensible defaults are used when unset.

# Where to store the persistent browser profile (holds your Google session).
# NOTEBOOKLM_USER_DATA_DIR=/home/you/.notebooklm-mcp/profile

# Run the browser headless (1) or visible (0). Login must be visible.
# NOTEBOOKLM_HEADLESS=1

# Explicit Chromium binary (cloud image ships one at /opt/pw-browsers).
# NOTEBOOKLM_CHROMIUM_PATH=/opt/pw-browsers/chromium/chrome-linux/chrome

# Timeouts in milliseconds.
# NOTEBOOKLM_ACTION_TIMEOUT_MS=45000
# NOTEBOOKLM_ANSWER_TIMEOUT_MS=120000

# Browser locale.
# NOTEBOOKLM_LOCALE=en-US

# --- iCloud Drive MCP (src/icloud-server.js) ---
# Root folder the iCloud server reads. Defaults to the standard iCloud Drive
# location for your OS; override only if yours differs.
# macOS:   ~/Library/Mobile Documents/com~apple~CloudDocs
# Windows: %USERPROFILE%\iCloudDrive
# ICLOUD_DRIVE_PATH=/Users/you/Library/Mobile Documents/com~apple~CloudDocs
