<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.quantum.pronostico</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/radamesvargasramirez/QUANTUM/norte-b/pronostico-sbh/ejecutar_lunes.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/radamesvargasramirez/QUANTUM/norte-b/pronostico-sbh</string>

    <!-- Martes (Weekday=2) a las 10:00 — movido desde lunes 07:00 el 2026-07-15
         porque el control volumétrico entrega con 24 h de retraso (datos del
         domingo disponibles el lunes; se cargan lunes PM y se corre martes 10:00). -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>2</integer>
        <key>Hour</key>
        <integer>10</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- No correr al cargar el agente; solo en el horario programado -->
    <key>RunAtLoad</key>
    <false/>

    <!-- Si la Mac estaba dormida a las 07:00, launchd lo dispara al despertar -->
    <key>StartCalendarIntervalIgnoreMissedIntervals</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/radamesvargasramirez/QUANTUM/norte-b/pronostico-sbh/salidas/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/radamesvargasramirez/QUANTUM/norte-b/pronostico-sbh/salidas/logs/launchd.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>DYLD_FALLBACK_LIBRARY_PATH</key>
        <string>/Users/radamesvargasramirez/QUANTUM/norte-b/pronostico-sbh/.venv/libomp</string>
    </dict>
</dict>
</plist>
